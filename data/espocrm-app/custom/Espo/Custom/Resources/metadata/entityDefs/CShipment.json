{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "pattern": "$noBadCharacters",
            "options": []
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "account": {
            "type": "link"
        },
        "order": {
            "type": "link",
            "view": "custom:views/c-shipment/fields/order"
        },
        "totalWeight": {
            "notNull": false,
            "type": "float",
            "readOnly": true,
            "isCustom": true,
            "tooltip": true
        },
        "totalVolume": {
            "notNull": false,
            "type": "float",
            "readOnly": true,
            "isCustom": true,
            "tooltip": true
        },
        "totalPackages": {
            "type": "int",
            "readOnly": true,
            "isCustom": true,
            "tooltip": true
        },
        "totalDeliveryPriceVnd": {
            "type": "currency",
            "readOnly": true,
            "onlyDefaultCurrency": true,
            "isCustom": true,
            "tooltip": true
        },
        "totalDeliveryPriceVndCurrency": {
            "default": "VND"
        },
        "deliveryDate": {
            "notNull": false,
            "type": "date",
            "isCustom": true,
            "default": "javascript: return this.dateTime.getToday();"
        },
        "notes": {
            "type": "text",
            "isCustom": true
        },
        "orderRemainingAmountVnd": {
            "type": "currency",
            "readOnly": true,
            "onlyDefaultCurrency": true,
            "isCustom": true,
            "tooltip": true
        },
        "orderRemainingAmountVndCurrency": {
            "default": "VND"
        },
        "totalPayableAmountVnd": {
            "type": "currency",
            "readOnly": true,
            "onlyDefaultCurrency": true,
            "isCustom": true,
            "tooltip": true
        },
        "totalPayableAmountVndCurrency": {
            "default": "VND"
        },
        "unitDeliveryPriceVnd": {
            "type": "currency",
            "min": 0,
            "isCustom": true,
            "onlyDefaultCurrency": true
        },
        "unitDeliveryPriceVndCurrency": {
            "default": "VND"
        },
        "serviceType": {
            "type": "enum",
            "options": [
                "TMĐT",
                "Hàng Lô",
                "Chính Ngạch"
            ],
            "style": {
                "TMĐT": null,
                "Hàng Lô": null,
                "Chính Ngạch": null
            },
            "default": "TMĐT",
            "maxLength": 100,
            "isCustom": true
        },
        "paid": {
            "notNull": true,
            "type": "bool",
            "isCustom": true,
            "audited": true
        },
        "additionalAmountVnd": {
            "type": "currency",
            "default": 0,
            "isCustom": true
        },
        "clientName": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true
        },
        "surcharge": {
            "type": "text",
            "rowsMin": 2,
            "cutHeight": 200,
            "isCustom": true
        },
        "deliveryPricingMode": {
            "type": "enum",
            "options": [
                "",
                "weight",
                "volume",
                "higher"
            ],
            "default": "",
            "maxLength": 20,
            "isCustom": true,
            "audited": true,
            "tooltip": true
        },
        "appliedDeliveryPricingBasis": {
            "type": "enum",
            "options": [
                "",
                "weight",
                "volume"
            ],
            "readOnly": true,
            "maxLength": 20,
            "isCustom": true
        },
        "unitDeliveryPricePerKgVnd": {
            "type": "currency",
            "min": 0,
            "isCustom": true,
            "onlyDefaultCurrency": true,
            "audited": true
        },
        "unitDeliveryPricePerKgVndCurrency": {
            "default": "VND"
        },
        "unitDeliveryPricePerM3Vnd": {
            "type": "currency",
            "min": 0,
            "isCustom": true,
            "onlyDefaultCurrency": true,
            "audited": true
        },
        "unitDeliveryPricePerM3VndCurrency": {
            "default": "VND"
        },
        "deliveryPriceByWeightVnd": {
            "type": "currency",
            "min": 0,
            "isCustom": true,
            "onlyDefaultCurrency": true,
            "readOnly": true
        },
        "deliveryPriceByWeightVndCurrency": {
            "default": "VND"
        },
        "deliveryPriceByVolumeVnd": {
            "type": "currency",
            "min": 0,
            "isCustom": true,
            "onlyDefaultCurrency": true,
            "readOnly": true
        },
        "deliveryPriceByVolumeVndCurrency": {
            "default": "VND"
        },
        "workflowStatus": {
            "type": "enum",
            "options": [
                "",
                "draft",
                "confirmed",
                "cancelled"
            ],
            "default": "",
            "readOnly": true,
            "isCustom": true,
            "maxLength": 20
        },
        "confirmedAt": {
            "type": "datetime",
            "readOnly": true,
            "isCustom": true
        },
        "cancelledAt": {
            "type": "datetime",
            "readOnly": true,
            "isCustom": true
        },
        "postedAmountVnd": {
            "type": "currency",
            "onlyDefaultCurrency": true,
            "isCustom": true,
            "readOnly": true
        },
        "paidAmountVnd": {
            "type": "currency",
            "onlyDefaultCurrency": true,
            "isCustom": true,
            "readOnly": true
        },
        "outstandingAmountVnd": {
            "type": "currency",
            "onlyDefaultCurrency": true,
            "isCustom": true,
            "readOnly": true
        },
        "oldBalanceSnapshotVnd": {
            "type": "currency",
            "onlyDefaultCurrency": true,
            "isCustom": true,
            "readOnly": true
        },
        "requestedTotalSnapshotVnd": {
            "type": "currency",
            "onlyDefaultCurrency": true,
            "isCustom": true,
            "readOnly": true
        },
        "invoiceSnapshot": {
            "type": "text",
            "readOnly": true,
            "isCustom": true
        },
        "invoiceSnapshotHtml": {
            "type": "text",
            "readOnly": true,
            "isCustom": true
        },
        "additionalOrders": {
            "type": "array",
            "isCustom": true,
            "view": "custom:views/c-shipment/fields/additional-orders"
        },
        "postedAmountVndCurrency": {
            "default": "VND"
        },
        "paidAmountVndCurrency": {
            "default": "VND"
        },
        "outstandingAmountVndCurrency": {
            "default": "VND"
        },
        "oldBalanceSnapshotVndCurrency": {
            "default": "VND"
        },
        "requestedTotalSnapshotVndCurrency": {
            "default": "VND"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "parcels": {
            "type": "hasMany",
            "foreign": "shipment",
            "entity": "CParcel",
            "audited": false,
            "isCustom": true
        },
        "account": {
            "type": "belongsTo",
            "foreign": "cShipments",
            "entity": "Account",
            "audited": false,
            "isCustom": true
        },
        "order": {
            "type": "belongsTo",
            "foreign": "shipment",
            "entity": "COrder",
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc",
        "textFilterFields": [
            "name",
            "clientName"
        ],
        "fullTextSearch": true,
        "countDisabled": false
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    },
    "optimisticConcurrencyControl": false,
    "repositoryClassName": "Espo\\Custom\\Repositories\\TransactionalLogistics"
}
