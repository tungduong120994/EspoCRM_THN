        "grandTotalPriceVnd": {
            "type": "currency",
            "readOnly": true,
            "isCustom": true,
            "tooltip": true
        },
        "serviceFeeVndCurrency": {
            "default": "VND"
        },
        "totalItemsPriceCnyCurrency": {
            "default": "CNY"
        },
        "totalOrderValueCnyCurrency": {
            "default": "CNY"
        },
        "totalOrderValueVndCurrency": {
            "default": "VND"
        },
        "domesticShippingFeeCnyCurrency": {
            "default": "CNY"
        },
