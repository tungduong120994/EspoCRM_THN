        },
        "totalItemsPriceCny": {
            "type": "currency",
            "readOnly": true,
            "isCustom": true,
            "onlyDefaultCurrency": true,
            "tooltip": true
        },
        "totalQuantity": {
            "type": "int",
            "isCustom": true,
            "readOnly": true,
            "tooltip": true
        },
        "totalOrderValueCny": {
            "type": "currency",
            "isCustom": true,
            "conversionDisabled": true,
            "readOnly": true,
            "tooltip": true
        },
        "totalOrderValueVnd": {
            "type": "currency",
            "isCustom": true,
            "conversionDisabled": false,
