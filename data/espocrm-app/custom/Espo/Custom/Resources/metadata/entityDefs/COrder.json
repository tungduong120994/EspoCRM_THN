        "vatVnd": {
            "type": "currency",
            "onlyDefaultCurrency": true,
            "isCustom": true,
            "readOnly": true
        },
        "declaredValueVndCurrency": {
            "default": "VND"
        },
        "documentFeeVndCurrency": {
            "default": "VND"
        },
        "declaredFeesVndCurrency": {
            "default": "VND"
        },
        "entrustmentVndCurrency": {
            "default": "VND"
        },
        "importTaxVndCurrency": {
            "default": "VND"
        },
        "vatVndCurrency": {
            "default": "VND"
        }
