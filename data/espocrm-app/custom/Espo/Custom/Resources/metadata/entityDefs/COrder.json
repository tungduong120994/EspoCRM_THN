        "estimatedChinaVietnamShippingFeeTotalPriceVnd": {
            "type": "currency",
            "isCustom": true,
            "onlyDefaultCurrency": true,
            "readOnly": true,
            "tooltip": true
        },
        "estimatedChinaVietnamShippingFeeTotalPriceVndCurrency": {
            "default": "VND"
