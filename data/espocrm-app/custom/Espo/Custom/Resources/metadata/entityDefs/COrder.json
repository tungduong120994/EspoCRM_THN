        "importTaxVnd": {
            "type": "currency",
            "onlyDefaultCurrency": true,
            "isCustom": true,
            "readOnly": true
        },
        "vatPercent": {
            "type": "float",
            "min": 0,
            "max": 100,
            "default": 0,
            "isCustom": true
