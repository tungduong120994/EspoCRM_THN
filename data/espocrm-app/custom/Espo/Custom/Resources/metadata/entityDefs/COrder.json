        "deliveryDate": {
            "notNull": false,
            "type": "date",
            "isCustom": true
        },
        "notes": {
            "type": "text",
            "rowsMin": 2,
            "cutHeight": 200,
            "isCustom": true
        },
        "account": {
            "type": "link",
            "nameField": "cID"
        },
        "contact": {
            "type": "link"
        },
