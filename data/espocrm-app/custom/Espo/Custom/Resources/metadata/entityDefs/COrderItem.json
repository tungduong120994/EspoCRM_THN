{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "pattern": "$noBadCharacters",
            "options": [],
            "readOnly": true,
            "inlineEditDisabled": false
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "product": {
            "type": "link",
            "required": true
        },
        "order": {
            "type": "link",
            "readOnly": false,
            "readOnlyAfterCreate": true
        },
        "quantity": {
            "type": "int",
            "required": true,
            "isCustom": true,
            "default": 1
        },
        "unitPriceCny": {
            "type": "currency",
            "isCustom": true,
            "readOnly": true,
            "conversionDisabled": true,
            "onlyDefaultCurrency": true,
            "tooltip": true
        },
        "productNameDetail": {
            "readOnly": true,
            "type": "foreign",
            "link": "product",
            "field": "name",
            "view": "views/fields/foreign-varchar",
            "isCustom": true
        },
        "notes": {
            "type": "text",
            "rowsMin": 2,
            "cutHeight": 200,
            "isCustom": true
        },
        "totalPriceCny": {
            "type": "currency",
            "isCustom": true,
            "onlyDefaultCurrency": true,
            "conversionDisabled": true,
            "readOnly": true,
            "tooltip": true
        },
        "unitPriceCnyCurrency": {
            "default": "CNY"
        },
        "totalPriceCnyCurrency": {
            "default": "CNY"
        },
        "trackingCode": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "product": {
            "type": "belongsTo",
            "foreign": "orderItems",
            "entity": "CProduct",
            "audited": false,
            "isCustom": true
        },
        "order": {
            "type": "belongsTo",
            "foreign": "orderItems",
            "entity": "COrder",
            "audited": false,
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc",
        "textFilterFields": [
            "name"
        ],
        "fullTextSearch": false,
        "countDisabled": false
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    },
    "optimisticConcurrencyControl": false,
    "repositoryClassName": "Espo\\Custom\\Repositories\\TransactionalLogistics"
}
