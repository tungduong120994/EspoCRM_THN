{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters",
            "options": [],
            "copyToClipboard": true
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "shipment": {
            "type": "link"
        },
        "weight": {
            "notNull": false,
            "type": "float",
            "isCustom": true
        },
        "volume": {
            "notNull": false,
            "type": "float",
            "isCustom": true
        },
        "packageCount": {
            "type": "int",
            "default": 1,
            "min": 1,
            "isCustom": true
        },
        "account": {
            "type": "link"
        },
        "status": {
            "type": "enum",
            "required": true,
            "options": [
                "delivered",
                "undelivered",
                "returned"
            ],
            "style": {
                "delivered": "success",
                "undelivered": "info",
                "returned": "danger"
            },
            "default": "undelivered",
            "labelType": "state",
            "maxLength": 100,
            "isCustom": true
        },
        "totalDeliveryPriceVnd": {
            "type": "currency",
            "readOnly": true,
            "isCustom": true,
            "onlyDefaultCurrency": true
        },
        "totalDeliveryPriceVndCurrency": {
            "default": "VND"
        },
        "notes": {
            "type": "text",
            "rowsMin": 2,
            "cutHeight": 200,
            "isCustom": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "shipment": {
            "type": "belongsTo",
            "foreign": "parcels",
            "entity": "CShipment",
            "audited": false,
            "isCustom": true
        },
        "account": {
            "type": "belongsTo",
            "foreign": "cParcels",
            "entity": "Account",
            "audited": false,
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}